    state.lmbHeld = false
    state.bagSource = nil
    state.gateState = "farming"
    state.emptyStreak = 0
    state.fullStreak = 0
    if state.autoEquip then equipCollector() end
    if state.autoFarm then task.wait(0.5); mouseDown() end
end)

