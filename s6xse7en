-- ═══ HUD ═════════════════════════════════════════════════════
local hud = Instance.new("ScreenGui")
hud.Name = "S6xSe7enHUD"
hud.ResetOnSpawn = false
local label = Instance.new("TextLabel")
label.Size = UDim2.new(0, 440, 0, 26)
label.Position = UDim2.new(0, 12, 1, -40)
label.BackgroundTransparency = 0.4
label.BackgroundColor3 = Color3.new(0, 0, 0)
label.TextColor3 = Color3.new(1, 1, 1)
label.Font = Enum.Font.Code
label.TextSize = 13
label.TextXAlignment = Enum.TextXAlignment.Left
label.Text = "pollen: ?"
label.Parent = hud
local okHud = pcall(function() hud.Parent = player:WaitForChild("PlayerGui") end)

task.spawn(function()
    while true do
        if okHud then
            local frac, p, c = getBagFill()
            local farmTxt = state.autoFarm and "FARM" or "off"
            local gateTxt = state.gateState
            if state.emptyStreak > 0 then
                gateTxt = gateTxt .. " " .. state.emptyStreak .. "/" .. RESUME_CONFIRM_TICKS
            end
            if state.converting then gateTxt = "converting" end
            if frac then
                label.Text = string.format("[%s | %s] pollen %d%%  (%s / %s)",
                    farmTxt, gateTxt, math.floor(frac * 100),
                    p and math.floor(p) or "?", c and math.floor(c) or "?")
            else
                label.Text = string.format("[%s | %s] pollen: not read", farmTxt, gateTxt)
            end
        end
        task.wait(0.5)
    end
end)

-- ═══ UI ══════════════════════════════════════════════════════
local Window     = Library:CreateWindow("S6x Se7en c o d e i")
local FarmTab    = Window:CreateTab("Farm")
local ConvertTab = Window:CreateTab("Convert")
local MiscTab    = Window:CreateTab("Misc")

local function getFieldNames()
    local names = {}
    local zones = getFlowerZones()
    if zones then
        for _, v in ipairs(zones:GetChildren()) do
            if v:IsA("BasePart") or v:IsA("Model") then names[#names+1] = v.Name end
        end
    end
    table.sort(names)
    if #names == 0 then
        names = {
            "Mushroom Field","Strawberry Field","Blue Flower Field","Sunflower Field",
            "Pineapple Patch","Pumpkin Patch","Cactus Field","Bamboo Field",
            "Spider Field","Rose Field","Pine Tree Forest","Stump Field",
            "Clover Field","Mountain Top Field","Coconut Field","Pepper Patch",
            "Dandelion Field",
        }
    end
    return names
end

Workspace:WaitForChild("FlowerZones", 20)
local fieldNames = getFieldNames()
state.field = fieldNames[1]

local FieldGroup   = FarmTab:CreateGroupbox("Field", "Left")
local MoveGroup    = FarmTab:CreateGroupbox("Movement", "Right")
local ConvertGroup = ConvertTab:CreateGroupbox("Convert", "Left")
local ActionGroup  = ConvertTab:CreateGroupbox("Actions", "Right")
local MiscGroup    = MiscTab:CreateGroupbox("Utility", "Left")

FieldGroup:CreateDropdown("Field", fieldNames, function(v) state.field = v end)
FieldGroup:CreateDropdown("Pattern", {"Square","Circle","Line","Random"}, function(v)
    state.pattern = v
end)
FieldGroup:CreateSlider("Radius", 10, 100, 30, function(v) state.radius = v end)

MoveGroup:CreateToggle("Auto Farm", function(v)
    state.autoFarm = v
    if v then
        waitForChar()
        task.spawn(function() task.wait(1); if state.autoFarm then mouseDown() end end)
    else
        mouseUp()
    end
end)
MoveGroup:CreateSlider("Walk Speed", 16, 120, 32, function(v) state.walkSpeed = v end)
MoveGroup:CreateButton("Teleport to Field", function()
    local cf = getFieldCFrame(state.field)
    if cf then tp(CFrame.new(cf.Position + Vector3.new(0, 4, 0))) end
end)
MoveGroup:CreateButton("Stop Farming", function()
    state.autoFarm = false
    mouseUp()
end)

ConvertGroup:CreateToggle("Auto Convert (pollen gate)", function(v)
    state.autoConvert = v
    state.bagWarned = false
    state.bagSource = nil
    state.gateState = "farming"
    state.emptyStreak = 0
    state.fullStreak = 0
    if v then
        print(TAG .. " pollen gate ON — stop at " .. state.bagThreshold ..
              "%, resume below " .. state.resumeBelow .. "%")
    end
end)
ConvertGroup:CreateSlider("Stop Farm at % Full", 50, 100, 100, function(v)
    state.bagThreshold = v
end)
ConvertGroup:CreateSlider("Resume Farm below %", 1, 30, 5, function(v)
    state.resumeBelow = v
end)
ConvertGroup:CreateSlider("Hive Wait (s)", 2, 10, 4, function(v) state.hiveWait = v end)

ActionGroup:CreateButton("Convert Now", function()
    task.spawn(function()
        local wasFarm = state.autoFarm
        if wasFarm then
            state.autoFarm = false
            mouseUp()
        end
        doConvert()
        if wasFarm and not state.autoConvert then
            state.autoFarm = true
            waitForChar()
            task.wait(0.3)
            mouseDown()
        end
    end)
end)
ActionGroup:CreateButton("Teleport to Hive Pad", function()
    local cf = getHiveCFrame()
    if cf then
        tp(cf)
        print(TAG .. " teleported via " .. state.hiveSource)
    else
        warn(TAG .. " no hive pad found")
    end
end)
ActionGroup:CreateButton("Print Hive Info", function()
    print(TAG .. " ── hive info ──")
    local hive = getHiveInstance()
    print("  hive instance:", hive and hive:GetFullName() or "nil")
    print("  resolved pad source:", state.hiveSource)
    print("  pad CFrame:", getHiveCFrame())
    print("  player.SpawnPos:", player:FindFirstChild("SpawnPos"))
    print("  player.RespawnLocation:", player.RespawnLocation)
end)
ActionGroup:CreateButton("Print Bag Status", function()
    local frac, p, c = getBagFill()
    print(TAG .. " ── pollen status ──")
    print("  fraction:", frac, "current:", p, "capacity:", c)
    print("  source:", state.bagSource and state.bagSource:GetFullName() or "none")
    print("  gateState:", state.gateState,
          " emptyStreak:", state.emptyStreak,
          " fullStreak:", state.fullStreak,
          " autoFarm:", state.autoFarm,
          " converting:", state.converting,
          " sinceConvert:", os.clock() - state.lastConvert)
end)
ActionGroup:CreateButton("Release Mouse", mouseUp)

MiscGroup:CreateToggle("Anti AFK", function(v) state.antiAfk = v end, true)
MiscGroup:CreateToggle("Auto Equip Collector", function(v)
    state.autoEquip = v
    if v then equipCollector() end
end, true)
MiscGroup:CreateButton("Equip Collector Now", equipCollector)
