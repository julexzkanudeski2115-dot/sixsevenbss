-- UI
-- ─────────────────────────────────────────────────────────────

local Window = Library:CreateWindow("S6x Se7en c o d e i")

local FarmTab    = Window:CreateTab("Farm")
local ConvertTab = Window:CreateTab("Convert")
local MiscTab    = Window:CreateTab("Misc")

local function getFieldNames()
    local names = {}
    local zones = getFlowerZones()

    if zones then
        for _, v in ipairs(zones:GetChildren()) do
            if v:IsA("BasePart") or v:IsA("Model") then
                names[#names + 1] = v.Name
            end
        end
    end

    table.sort(names)

    if #names == 0 then
        names = {
            "Mushroom Field", "Strawberry Field", "Blue Flower Field",
            "Sunflower Field", "Pineapple Patch", "Pumpkin Patch",
            "Cactus Field", "Bamboo Field", "Spider Field",
            "Rose Field", "Pine Tree Forest", "Stump Field",
            "Clover Field", "Mountain Top Field", "Coconut Field",
            "Pepper Patch", "Dandelion Field",
        }
    end

    return names
end

Workspace:WaitForChild("FlowerZones", 20)
local fieldNames = getFieldNames()
state.field = fieldNames[1]

local FieldGroup   = FarmTab:CreateGroupbox("Field", "Left")
local MoveGroup    = FarmTab:CreateGroupbox("Movement", "Right")
local ConvertGroup = ConvertTab:CreateGroupbox("Convert", "Left")
local ActionGroup  = ConvertTab:CreateGroupbox("Actions", "Right")
local MiscGroup    = MiscTab:CreateGroupbox("Utility", "Left")

-- farm tab
FieldGroup:CreateDropdown("Field", fieldNames, function(v) state.field = v end)
FieldGroup:CreateDropdown("Pattern", {"Square", "Circle", "Line", "Random"}, function(v) state.pattern = v end)
FieldGroup:CreateSlider("Radius", 10, 100, 30, function(v) state.radius = v end)

MoveGroup:CreateToggle("Auto Farm", function(v)
    state.autoFarm = v
    if v then waitForChar() end
end)
MoveGroup:CreateSlider("Walk Speed", 16, 120, 32, function(v) state.walkSpeed = v end)
MoveGroup:CreateButton("Teleport to Field", function()
    local cf = getFieldCFrame(state.field)
    if cf then tp(CFrame.new(cf.Position + Vector3.new(0, 4, 0))) end
end)
MoveGroup:CreateButton("Stop Farming", function() state.autoFarm = false end)

-- convert tab
ConvertGroup:CreateToggle("Auto Convert", function(v)
    state.autoConvert = v
    if v then state.lastConvert = os.clock() end
end)
ConvertGroup:CreateSlider("Convert Every (s)", 30, 300, 90, function(v) state.convertInterval = v end)
ConvertGroup:CreateSlider("Hive Wait (s)", 2, 10, 4, function(v) state.hiveWait = v end)

ActionGroup:CreateButton("Convert Now", function()
    task.spawn(function()
        doConvert()
        state.lastConvert = os.clock()
    end)
end)

-- misc tab
MiscGroup:CreateToggle("Anti AFK", function(v) state.antiAfk = v end, true)
MiscGroup:CreateToggle("Auto Equip Collector", function(v)
    state.autoEquip = v
    if v then equipCollector() end
end, true)
MiscGroup:CreateButton("Equip Collector Now", equipCollector)
